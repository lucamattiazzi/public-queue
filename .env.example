# Generate an untracked .env using: node scripts/setup-env.mjs
PQ_ADMIN_TOKEN=
PQ_DOMAIN=queue.example.com
PQ_PUBLIC_URL=https://queue.example.com
# Comma-separated static frontend origins; * permits bearer-authenticated SDKs
# from any frontend. Cookie-authenticated account mutations remain same-origin.
PQ_ORIGINS=*
# Only for compose.yaml behind your EXISTING proxy. Standalone compose sets this.
PQ_TRUST_PROXY=

# Complete your actual legal identity before enabling public signup.
PQ_OPERATOR_NAME=
PQ_OPERATOR_ADDRESS=
PQ_OPERATOR_TAX_ID=
PQ_SUPPORT_EMAIL=
# Actual hosting region, SMTP provider, Stripe, international transfer safeguards
# and your backup retention. Displayed verbatim as text on the privacy page.
PQ_PROVIDER_DISCLOSURE=
PQ_MAX_ACCOUNTS=100
PQ_MAX_EMAILS_PER_DAY=500

# Authenticated SMTP; requires TLS (465 implicit or 587 STARTTLS).
PQ_SMTP_HOST=
PQ_SMTP_PORT=587
PQ_SMTP_USER=
PQ_SMTP_PASSWORD=
PQ_EMAIL_FROM=

# Configure all three together, first in Stripe test mode, then all in live mode.
# Price: EUR 29.00/year, tax_behavior=inclusive, no trial or metered billing.
PQ_STRIPE_SECRET_KEY=
PQ_STRIPE_WEBHOOK_SECRET=
PQ_STRIPE_PRICE_ID=
# Enable only after configuring tax registrations and product tax code in Stripe.
PQ_STRIPE_AUTOMATIC_TAX=false

# Your verified email(s), comma-separated. Server-only commercial quota exemption.
# Exact addresses only; never *, domains or client-supplied values. No Stripe needed.
PQ_OWNER_EMAILS=
