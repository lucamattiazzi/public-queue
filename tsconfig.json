{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
